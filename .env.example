# 랜딩 운영 값 — .env.local 로 복사해 채운다. 비어 있으면 해당 버튼은 '준비 중' 안내가 뜬다.
SITE_URL=                                # 예: https://fity.co.kr  (canonical · og:url · sitemap · QR에 사용)
NEXT_PUBLIC_EXPERT_WEB_LOGIN_URL=        # 전문가 WEB 로그인
NEXT_PUBLIC_IOS_APP_STORE_URL=
NEXT_PUBLIC_ANDROID_PLAY_STORE_URL=
NEXT_PUBLIC_APP_SMART_URL=               # (선택) 기기별 스토어로 보내는 링크. 비우면 SITE_URL/?go=app
NEXT_PUBLIC_CS_URL=                      # FITY 카카오톡 채널
NEXT_PUBLIC_CS_EMAIL=                    # 고객센터 이메일
NEXT_PUBLIC_GA4_ID=                      # 예: G-XXXXXXX
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=     # 네이버 서치어드바이저 소유확인 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=    # 구글 서치 콘솔 소유확인 값
